#!/usr/bin/env bash
set -euo pipefail

run_oxc_scripts() {
  local dir="$1"
  if git diff --cached --quiet -- "$dir/"; then
    return
  fi

  echo "Running lint:fix in $dir..."
  (cd "$dir" && pnpm lint:fix)

  echo "Running fmt in $dir..."
  (cd "$dir" && pnpm fmt)

  git diff --quiet -- "$dir/" || git add "$dir/"
}

build_translations() {
  local dir="$1"
  if git diff --cached --quiet -- "$dir/"; then
    return
  fi

  echo "Running build:translations in $dir..."
  (cd "$dir" && pnpm build:translations)

  git diff --quiet -- "$dir/" || git add "$dir/"
}

run_oxc_scripts frontend
run_oxc_scripts database
build_translations frontend
