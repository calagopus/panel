{
  "name": "panel-rs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "author": "Calagopus",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc",
    "build": "pnpm build:translations && vite build",
    "build:ci": "pnpm typecheck && cross-env PRECOMPRESS=true vite build",
    "build:fast": "cross-env FAST_REACT_COMPILER=true pnpm build",
    "build:docs": "typedoc --options typedoc.json --skipErrorChecking",
    "build:translations": "tsx build-translations.mts",
    "diff:translations": "tsx diff-translations.mts",
    "format:translations": "tsx format-translations.mts",
    "biome:validate": "biome format --css-parse-tailwind-directives=true && biome lint --css-parse-tailwind-directives=true && biome check",
    "biome:fix": "biome format --write --css-parse-tailwind-directives=true && biome lint --write --css-parse-tailwind-directives=true && biome check --write",
    "biome:fix-unsafe": "biome format --write --css-parse-tailwind-directives=true && biome lint --write --css-parse-tailwind-directives=true && biome check --write --unsafe"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
