    "@xterm/xterm": "^6.0.0",
    "axios": "^1.19.0",
    "classnames": "^2.5.1",
    "cron-parser": "^5.8.1",
    "cronstrue": "^3.24.0",
    "debounce": "^3.0.0",
    "deepmerge-ts": "^7.1.6",
    "events": "^3.3.0",
    "highlight.js": "^11.12.0",
    "history": "^5.3.0",
    "ignore": "^7.0.6",
    "immer": "^11.1.16",
    "js-yaml": "^5.2.3",
    "mantine-form-zod-resolver": "^1.3.0",
    "mathjs": "^15.2.0",
    "motion": "^12.43.0",
    "object-deep-merge": "^2.0.1",
    "pathe": "^2.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-avatar-editor": "^15.1.0",
    "react-dom": "^19.2.8",
    "react-fast-compare": "^3.2.2",
    "react-google-recaptcha": "^3.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "react-spinners": "^0.17.0",
    "react-zoom-pan-pinch": "^4.0.4",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "shared": "workspace:*",
    "svg-country-flags": "^1.2.10",
    "tailwindcss": "^4.3.3",
    "tzdata": "^1.0.50",
    "uuid": "^14.0.1",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^4.4.3",
    "zustand": "^5.0.15",
    "zustand-utils": "^2.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
