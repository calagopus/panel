{
	"languages": {
		"TypeScript": {
			"language_servers": ["tsgo", "oxlint", "oxfmt"],
			"formatter": [
				{
					"code_action": "source.fixAll.oxc"
				},
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		},
		"TSX": {
			"language_servers": ["tsgo", "oxlint", "oxfmt"],
			"formatter": [
				{
					"code_action": "source.fixAll.oxc"
				},
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		}
	},
	"lsp": {
		"oxlint": {
			"binary": {
				"path": "node",
				"arguments": ["frontend/node_modules/oxlint/bin/oxlint", "--lsp"]
			}
		},
		"oxfmt": {
			"binary": {
				"path": "node",
				"arguments": ["frontend/node_modules/oxfmt/bin/oxfmt", "--lsp"]
			}
		}
	}
}
